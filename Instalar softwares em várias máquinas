---
- name: Instalar softwares em múltiplas máquinas Ubuntu
  hosts: lab6
  become: true
  gather_facts: true

  vars:
    softwares_obrigatorios:
      - pymol
      - git
      - curl
      - wget
      - vim
      - nano
      - htop
      - tree
      - unzip
      - zip
      - build-essential
      - python3
      - python3-pip
      - python3-venv
      - pipx
      - cmake
      - gcc
      - g++
      - make
      - default-jdk
      - r-base

    softwares_opcionais:
      - ncbi-blast+
      - hmmer
      - mafft
      - muscle
      - clustalo

  tasks:
    - name: Verificar sistema operacional
      ansible.builtin.assert:
        that:
          - ansible_facts['distribution'] == 'Ubuntu'
        fail_msg: "Sistema operacional não suportado."

    - name: Atualizar lista de pacotes
      ansible.builtin.apt:
        update_cache: true
        cache_valid_time: 3600

    - name: Atualizar pacotes instalados
      ansible.builtin.apt:
        upgrade: safe

    - name: Instalar softwares obrigatórios
      ansible.builtin.apt:
        name: "{{ softwares_obrigatorios }}"
        state: present

    - name: Verificar disponibilidade dos softwares opcionais
      ansible.builtin.command:
        cmd: "apt-cache show {{ item }}"
      loop: "{{ softwares_opcionais }}"
      register: disponibilidade
      changed_when: false
      failed_when: false

    - name: Instalar softwares opcionais disponíveis
      ansible.builtin.apt:
        name: "{{ item.item }}"
        state: present
      loop: "{{ disponibilidade.results }}"
      when: item.rc == 0

    - name: Verificar Python
      ansible.builtin.command:
        cmd: python3 --version
      register: python_result
      changed_when: false

    - name: Verificar Git
      ansible.builtin.command:
        cmd: git --version
      register: git_result
      changed_when: false

    - name: Verificar PyMOL
      ansible.builtin.command:
        cmd: pymol --help
      register: pymol_result
      changed_when: false
      failed_when: false

    - name: Relatório final
      ansible.builtin.debug:
        msg:
          - "Máquina: {{ inventory_hostname }}"
          - "Ubuntu: {{ ansible_facts['distribution_version'] }}"
          - "Python: {{ python_result.stdout }}"
          - "Git: {{ git_result.stdout }}"
          - "PyMOL: {{ 'OK' if pymol_result.rc == 0 else 'Verificar' }}"
          - "Instalação concluída."

