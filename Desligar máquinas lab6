Arquivo shutdown_lab6.yml

---
- name: Desligar máquinas do lab6
  hosts: lab6
  gather_facts: false
  become: true

  tasks:
    - name: Verificar conectividade com as máquinas
      ansible.builtin.ping:
      register: ping_result

    - name: Desligar as máquinas
      ansible.builtin.command:
        argv:
          - /usr/sbin/shutdown
          - -h
          - now
      async: 1
      poll: 0
      when: ping_result is succeeded

