Playbook Ansible para criar usuário com senha

1. Playbook criar_usuario.yml
---
- name: Criar usuário em máquinas com sistema operacional Ubuntu
  hosts: lab6
  become: yes
  tasks:
    - name: Criar usuário com senha
      ansible.builtin.user:
        name: teste
        comment: "teste"
        shell: /bin/bash
        password: "{{ '@nsdmWe$' | password_hash('sha512') }}"
        state: present


